# Normalize text
* text=auto eol=lf
*.cs text
*.asmdef text
*.json text
*.uxml text
*.uss text
*.md text
*.sh text eol=lf
*.ps1 text

# Binary assets
*.png binary
*.jpg binary
*.keystore binary

# Git LFS for intentionally versioned large assets (opt-in patterns)
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
